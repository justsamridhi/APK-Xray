# .env.example
# Configuration placeholders for APK-Xray backend
# ---------------------------------------------------
# Maximum upload size (bytes). Default: 52428800 (50 MB)
APK_XRAY_MAX_UPLOAD_BYTES=52428800

# ZIP archive limits
APK_XRAY_MAX_ZIP_ENTRIES=1000
APK_XRAY_MAX_TOTAL_UNCOMPRESSED_BYTES=209715200
APK_XRAY_MAX_ENTRY_UNCOMPRESSED_BYTES=52428800
APK_XRAY_MAX_COMPRESSION_RATIO=100.0

# Gemma 4 AI integration
# Endpoint URL for the Gemma 4 model (example placeholder)
GEMMA4_ENDPOINT=https://your-gemma-endpoint.example.com/v1/models/gemma-4:generateContent
# API key for authentication (do NOT commit real key)
GEMMA4_API_KEY=YOUR_GEMMA_API_KEY
# Optional model identifier (if needed separately)
GEMMA4_MODEL=gemma-4
# Timeout for Gemma requests (seconds)
APK_XRAY_GEMMA_TIMEOUT=90

# Additional FastAPI settings can be added here as needed
