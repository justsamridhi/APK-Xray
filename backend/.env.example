APK_XRAY_MAX_UPLOAD_BYTES=52428800
APK_XRAY_GEMMA_TIMEOUT=90
# Leave these empty to run deterministic analysis without AI explanations.
GEMMA4_ENDPOINT=
GEMMA4_API_KEY=

# Sentry tracing (optional).
# Leave SENTRY_DSN empty to disable Sentry completely.
# SENTRY_TRACES_SAMPLE_RATE must be between 0.0 and 1.0 when set.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
